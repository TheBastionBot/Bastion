        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.7.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.112.3",
