    "author": "TRACTION",
    "license": "",
    "private": true,
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "build": "tsc",
        "build:commands": "tesseract commands",
        "commands": "tesseract publish",
        "lint": "eslint .",
        "migrate": "node ./dist/migrate.js",
        "start": "node .",
        "test": "npm run test:unit",
        "test:coverage": "vitest run --coverage --passWithNoTests",
